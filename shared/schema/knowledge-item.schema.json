{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "KnowledgeItem",
  "description": "知识库单条规则（契约 §4.3）",
  "type": "object",
  "required": ["id", "scope", "category", "keywords", "title", "content", "severity", "updated_at"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(laptop|digital|chao_wan|beauty|bed|study|cross)_\\d{3}$"
    },
    "scope": { "type": "string", "enum": ["category", "universal"] },
    "category": {
      "type": "string",
      "enum": ["laptop", "digital", "chao_wan", "beauty", "bed", "study", "universal"]
    },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "items": { "type": "string" }
    },
    "title": { "type": "string", "maxLength": 16 },
    "content": { "type": "string", "minLength": 60, "maxLength": 120 },
    "severity": { "type": "string", "enum": ["high", "medium", "low"] },
    "updated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "universal" } } },
      "then": { "properties": { "category": { "const": "universal" } } }
    }
  ]
}
