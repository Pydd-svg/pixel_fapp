/**
 * tokens.wxss —— 设计变量唯一真源
 * 视觉语言：奶油底 + 深墨标题 + 大圆角白卡 + 柠檬绿胶囊
 * 色值只允许出现在本文件；页面/组件一律引用变量。
 */
page {
  /* 强调色：柠檬绿 */
  --c-primary: #CBF04F;
  --c-primary-weak: #F3FBD9;
  --c-primary-press: #3F6B12;
  --c-primary-soft: #E8F7BE;
  --c-primary-ring: rgba(203, 240, 79, .32);

  /* 风险警示：与主色解耦，保持橙红 */
  --c-danger: #FF5A3C;
  --c-danger-weak: #FFF1EE;
  --c-danger-press: #C2410C;
  --c-on-danger: #FFFFFF;

  /* 墨色与中性色 */
  --c-ink: #16241F;
  --c-text-1: #16241F;
  --c-text-2: #4E5B54;
  --c-text-3: #93A09A;
  --c-bg: #F4F6F0;
  /* 与 --c-bg 同色但全透明：给渐隐遮罩用，别在组件里写死 rgba */
  --c-bg-fade: rgba(244, 246, 240, 0);
  --c-bg-warm: #FBFCF8;
  --c-surface-2: #EFF2EA;
  --c-card: #FFFFFF;
  --c-line: #E5EAE1;
  --c-on-primary: #16241F;
  --c-on-dark: #FBFCF8;
  --c-on-dark-dim: rgba(251, 252, 248, .60);

  /* 语义色 */
  --c-warn: #F0A93B;
  --c-warn-weak: #FFF5E3;
  --c-success: #4F9A6A;
  --c-success-weak: #EAF4EC;
  --c-high: #FF5A3C;
  --c-medium: #F0A93B;
  --c-low: #93A09A;

  /* 遮罩、骨架、微光 */
  --c-mask: rgba(18, 33, 28, .42);
  --c-skeleton: #E9EDE4;
  --c-shimmer: rgba(255, 255, 255, .82);
  --c-flag-dot: rgba(63, 107, 18, .10);

  /* 圆角（契约锁定三档） */
  --r-card: 24rpx;
  --r-btn: 16rpx;
  --r-pill: 999px;

  /* 间距 */
  --sp-card: 32rpx;
  --sp-gap: 24rpx;
  --sp-sm: 16rpx;
  --sp-xs: 8rpx;
  --sp-lg: 48rpx;

  /* 字号 */
  --fs-title: 40rpx;
  --fs-body: 28rpx;
  --fs-hint: 24rpx;
  --fs-pill: 22rpx;
  --fs-display: 56rpx;
  --fs-num: 72rpx;

  /* 阴影 */
  --shadow-card: 0 4rpx 24rpx rgba(0, 0, 0, .06);
  --lh-body: 1.65;

  /* 动效 */
  --motion-fast: 160ms;
  --motion-base: 220ms;
  --motion-sheet: 300ms;
  --ease-out: cubic-bezier(.22, .9, .3, 1);
  --ease-spring: cubic-bezier(.34, 1.4, .5, 1);

  /* ---- Hacknet 终端风：使用前必读卡的故障溶解倒计时 ----
     刻意跳出奶油/柠檬体系，用近黑底 + 荧光绿等宽字，制造「机器在倒计时」的对比 */
  --c-term-bg: #0B100A;
  --c-term-bg-2: #111A0F;
  --c-term-fg: #CBF04F;
  --c-term-fg-dim: rgba(203, 240, 79, .56);
  --c-term-line: rgba(203, 240, 79, .16);
  --c-term-scan: rgba(203, 240, 79, .05);
  --c-term-bar-off: rgba(203, 240, 79, .18);
  --c-term-glow: rgba(203, 240, 79, .10);
  --c-term-shadow: rgba(11, 16, 10, .30);
  --c-term-ghost-cyan: #5BE3C6;
  --c-term-ghost-magenta: #E8597F;

  /* 等宽字族（倒计时 / 终端文案） */
  --font-mono: "SF Mono", "Menlo", "Consolas", "Courier New", monospace;

  /* ---- 旧变量兼容别名（dev 页 / 遗留组件继续可用） ---- */
  --c-primary-text: var(--c-primary-press);
  --c-ink-2: var(--c-text-2);
  --c-ink-3: #6F7C76;
  --c-ink-4: var(--c-text-3);
  --c-surface: var(--c-card);
  --c-chip: var(--c-surface-2);
  --c-ok: var(--c-success);
  --fs-aux: var(--fs-hint);
  --sp-in: var(--sp-card);
  --sh-card: var(--shadow-card);
}
