/* 全局基础：字体、按钮重置、占位符、按压反馈与共用动画 */
page {
  background: var(--c-bg);
  color: var(--c-text-1);
  font-size: var(--fs-body);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  line-height: var(--lh-body);
  -webkit-font-smoothing: antialiased;
}

view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}

button { padding: 0; margin: 0; line-height: normal; font-size: var(--fs-body); }
button::after { border: none; }
.bk-placeholder { color: var(--c-text-3); font-size: var(--fs-body); }

/* 可点元素最小点击区 */
.tap { min-height: 88rpx; }
.page { min-height: 100vh; padding: var(--sp-gap) var(--sp-gap) 48rpx; }

/* 所有可点元素统一挂 hover-class="is-pressed"，按下即回弹 */
.is-pressed {
  transform: scale(.965);
  opacity: .88;
  transition: transform var(--motion-fast) var(--ease-spring), opacity var(--motion-fast) var(--ease-out);
}

/* 旧骨架屏占位 */
.sk {
  background: linear-gradient(90deg, var(--c-skeleton) 25%, var(--c-shimmer) 37%, var(--c-skeleton) 63%);
  background-size: 400% 100%;
  animation: sk 1.2s ease infinite;
  border-radius: 8rpx;
}

@keyframes sk {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}
@keyframes bk-shimmer {
  from { background-position: -320rpx 0; }
  to { background-position: 320rpx 0; }
}
@keyframes bk-rise {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes bk-sheet-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes bk-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes bk-caret {
  0%, 45% { opacity: 1; }
  50%, 100% { opacity: 0; }
}
@keyframes bk-pop {
  0% { transform: scale(.86); opacity: 0; }
  70% { transform: scale(1.04); }
  100% { transform: scale(1); opacity: 1; }
}
.bk-skeleton-surface {
  background-image: linear-gradient(90deg, var(--c-skeleton) 20%, var(--c-shimmer) 50%, var(--c-skeleton) 80%);
  background-size: 640rpx 100%;
  animation: bk-shimmer 1.4s linear infinite;
}
