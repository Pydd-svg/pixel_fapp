<view class="dc-root ext-class">
  <view wx:if="{{state === 'loading'}}" class="dc-skeleton">
    <view class="dc-sk-line dc-sk-title"></view>
    <view class="dc-sk-line"></view>
    <view class="dc-sk-block"></view>
    <view class="dc-sk-block"></view>
  </view>

  <view wx:elif="{{state === 'degraded'}}" class="dc-degraded">
    <view class="dc-degraded-title">! AI 开小差了</view>
    <view class="dc-degraded-desc">先把三条不会错的通用建议给你</view>
    <view wx:if="{{errorCode}}" class="dc-degraded-code">错误码 {{errorCode}}<text wx:if="{{errorText}}"> · {{errorText}}</text></view>
    <view wx:if="{{errorDetail}}" class="dc-degraded-detail">{{errorDetail}}</view>
    <view wx:for="{{fallbackFlags}}" wx:key="*this" class="dc-degraded-line">{{index + 1}}. {{item}}</view>
    <button class="dc-retry" hover-class="is-pressed" hover-stay-time="80" bindtap="onRetry">再试一次</button>
  </view>

  <view wx:elif="{{state === 'empty' || !card}}" class="dc-empty">还没有决策卡</view>

  <view wx:else class="dc-card">
    <view class="dc-head">
      <text class="dc-title">{{card.card_title}}</text>
      <text wx:if="{{confidenceLabel}}" class="dc-badge {{confidenceClass}}">{{confidenceLabel}}</text>
    </view>
    <view class="dc-tags">
      <text wx:for="{{card.tags}}" wx:key="*this" class="dc-tag">{{item}}</text>
    </view>

    <view wx:if="{{entityUnknown}}" class="dc-unverified">
      未核实到「{{entityText}}」的官方商品信息，以下为{{categoryLabel}}通用避坑建议
    </view>

    <view wx:for="{{card.recommendations}}" wx:key="type" class="dc-rec dc-rec-{{index}}">
      <text class="dc-rec-type">{{item.type}}</text>
      <view class="dc-rec-name">{{item.name}}</view>
      <view class="dc-rec-price">
        <text class="dc-price-val">{{item.price_expectation || '参考区间暂缺'}}</text>
        <text wx:if="{{isEstimate && item.price_expectation}}" class="dc-price-tag">估算</text>
      </view>
      <view class="dc-rec-line {{expanded[index] ? '' : 'dc-clamp'}}" data-idx="{{index}}"
        hover-class="is-pressed" hover-stay-time="80" bindtap="onTogglePros">优点：{{item.pros}}</view>
      <view class="dc-rec-line {{expanded[index] ? '' : 'dc-clamp'}}" data-idx="{{index}}"
        hover-class="is-pressed" hover-stay-time="80" bindtap="onTogglePros">代价：{{item.cons}}</view>
    </view>

    <view wx:if="{{priceNote}}" class="dc-price-note">{{priceNote}}</view>

    <view class="dc-flags">
      <view class="dc-flags-title"><text class="dc-flag-icon">!</text> 避坑红线</view>
      <view wx:for="{{card.red_flags}}" wx:key="*this" class="dc-flag">· {{item}}</view>
    </view>

    <view class="dc-keyword">
      <view class="dc-keyword-label">搜索词</view>
      <view class="dc-keyword-row">
        <text class="dc-keyword-text">{{card.search_keyword}}</text>
        <button class="dc-copy" hover-class="is-pressed" hover-stay-time="80" bindtap="onCopyKeyword">复制</button>
      </view>
    </view>

    <view wx:if="{{showRefs && refsList.length}}" class="dc-refs">
      <text class="dc-refs-label">依据（点开看原文）：</text>
      <text wx:for="{{refsList}}" wx:key="*this" class="dc-ref" data-id="{{item}}" bindtap="onRefTap">{{item}}</text>
    </view>
    <view wx:if="{{showRefs && state === 'done' && !refsList.length}}" class="dc-refs dc-refs-empty">
      暂无该品类的可靠知识条目，以下为通用建议
    </view>

    <view class="dc-disclaimer">{{card.disclaimer}}</view>
  </view>

  <view wx:if="{{state === 'done'}}" class="dc-actions">
    <button class="dc-btn-primary" hover-class="is-pressed" hover-stay-time="80" bindtap="onVerify">查全网真实评测</button>
    <view class="dc-btn-row">
      <button class="dc-btn-ghost" hover-class="is-pressed" hover-stay-time="80" bindtap="onSave">保存</button>
      <button class="dc-btn-ghost" hover-class="is-pressed" hover-stay-time="80" open-type="share" bindtap="onShare">转发</button>
      <button class="dc-btn-ghost" hover-class="is-pressed" hover-stay-time="80" bindtap="onReport">举报</button>
    </view>
  </view>
</view>
