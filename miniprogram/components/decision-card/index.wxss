/* decision-card 样式 —— A 岗兜底版（保证开发者工具里可读、可验收）
   C 岗接手后整体替换视觉细节；class 语义与字段名不要改。
   色值一律走 tokens.wxss 变量，C 改 tokens 即可全局换肤。 */

.dc {
  background: var(--c-surface, #FFFFFF);
  border-radius: var(--r-card, 24rpx);
  padding: var(--sp-in, 32rpx);
  margin-bottom: var(--sp-gap, 24rpx);
  box-shadow: var(--sh-card, 0 4rpx 24rpx rgba(0, 0, 0, 0.06));
}

/* ---------- 降级提示条 ---------- */
.dc__degrade {
  display: flex;
  align-items: center;
  background: #FFF7ED;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 24rpx;
}
.dc__degrade-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--c-primary-text, #C2410C);
}

/* ---------- 标题与元信息 ---------- */
.dc__head { display: block; }
.dc__title {
  display: block;
  font-size: var(--fs-title, 40rpx);
  font-weight: 700;
  line-height: 1.35;
  color: var(--c-ink, #1F2937);
}
.dc__meta { display: flex; flex-wrap: wrap; align-items: center; margin-top: 12rpx; }
.dc__conf,
.dc__budget {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--r-pill, 999px);
  margin-right: 12rpx;
  margin-bottom: 8rpx;
  background: var(--c-chip, #F3F4F6);
  color: var(--c-ink-2, #4B5563);
}
.dc__conf--high { background: #ECFDF5; color: #047857; }
.dc__conf--medium { background: #F3F4F6; color: #4B5563; }
.dc__conf--low { background: #FFF1EE; color: var(--c-primary-text, #C2410C); }

/* ---------- 标签 ---------- */
.dc__tags { display: flex; flex-wrap: wrap; margin-top: 16rpx; }

/* ---------- 推荐方案 ---------- */
.dc__section { margin-top: var(--sp-gap, 24rpx); }
.dc__section-title {
  display: block;
  font-size: 24rpx;
  color: var(--c-ink-4, #9CA3AF);
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}
.dc__rec {
  background: #FAFBFC;
  border: 1rpx solid var(--c-line, #E5E7EB);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.dc__rec:last-child { margin-bottom: 0; }
.dc__rec-head { display: flex; align-items: baseline; flex-wrap: wrap; }
.dc__rec-type {
  font-size: 22rpx;
  color: #FFFFFF;
  background: var(--c-ink-3, #6B7280);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.dc__rec-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-ink, #1F2937);
  flex: 1;
}
.dc__rec-price {
  display: block;
  font-size: 26rpx;
  color: var(--c-primary-text, #C2410C);
  margin-top: 8rpx;
}
.dc__rec-row { display: flex; align-items: flex-start; margin-top: 10rpx; }
.dc__rec-label {
  font-size: 24rpx;
  color: var(--c-ink-4, #9CA3AF);
  width: 76rpx;
  flex-shrink: 0;
}
.dc__rec-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--c-ink-2, #4B5563);
  line-height: 1.55;
}
.dc__rec-text--cons { color: #B45309; }

/* ---------- 搜索词 ---------- */
.dc__kw {
  display: flex;
  align-items: center;
  margin-top: var(--sp-gap, 24rpx);
  background: var(--c-chip, #F3F4F6);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}
.dc__kw-main { flex: 1; min-width: 0; }
.dc__kw-label {
  display: block;
  font-size: 22rpx;
  color: var(--c-ink-4, #9CA3AF);
}
.dc__kw-text {
  display: block;
  font-size: 28rpx;
  color: var(--c-ink, #1F2937);
  margin-top: 4rpx;
  word-break: break-all;
}
.dc__kw-copy {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 0 24rpx;
  height: 64rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  border-radius: 12rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--c-line, #E5E7EB);
  font-size: 24rpx;
  color: var(--c-ink-2, #4B5563);
  text-align: center;
}

/* ---------- 依据条目 ---------- */
.dc__refs { display: flex; flex-wrap: wrap; align-items: center; margin-top: 20rpx; }
.dc__refs-label {
  font-size: 22rpx;
  color: var(--c-ink-4, #9CA3AF);
  margin-right: 12rpx;
}
.dc__ref {
  font-size: 22rpx;
  color: var(--c-ink-3, #6B7280);
  background: #F9FAFB;
  border: 1rpx solid var(--c-line, #E5E7EB);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin: 0 8rpx 8rpx 0;
}

/* ---------- 操作区 ---------- */
.dc__actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--sp-gap, 24rpx);
}
.dc__btn {
  flex: 1;
  min-width: 180rpx;
  margin: 0 12rpx 12rpx 0;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: var(--r-btn, 16rpx);
  font-size: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid var(--c-line, #E5E7EB);
  color: var(--c-ink-2, #4B5563);
  padding: 0;
}
.dc__btn:last-child { margin-right: 0; }
.dc__btn--primary {
  background: var(--c-primary, #FF5A3C);
  border-color: var(--c-primary, #FF5A3C);
  color: #FFFFFF;
  /* 主按钮独占一行，视觉上只留一个主动作 */
  flex-basis: 100%;
  margin-right: 0;
}
.dc__btn--plain::after { border: none; }

/* ---------- AI 标识 ---------- */
.dc__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  margin-top: var(--sp-gap, 24rpx);
  padding-top: 20rpx;
  border-top: 1rpx solid var(--c-line, #E5E7EB);
}
.dc__disclaimer {
  flex: 1;
  font-size: 22rpx;
  color: var(--c-ink-4, #9CA3AF);
  line-height: 1.5;
}
.dc__report { display: flex; flex-shrink: 0; margin-left: 16rpx; }
.dc__report-item {
  font-size: 22rpx;
  color: var(--c-ink-4, #9CA3AF);
  padding: 8rpx 12rpx;
  text-decoration: underline;
}

/* ---------- 骨架屏 ---------- */
.dc__sk-title { height: 40rpx; width: 60%; margin-bottom: 16rpx; }
.dc__sk-line { height: 28rpx; margin-bottom: 12rpx; }
.dc__sk-block { height: 160rpx; margin-top: 16rpx; }
