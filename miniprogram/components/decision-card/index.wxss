/* 决策卡：六区块信息层级 + 四态。卡内分组、大数值、浅底分层、细线收束 */
.dc-root { display: block; }
.dc-card { position: relative; overflow: hidden; background: var(--c-card); border-radius: var(--r-card); padding: var(--sp-card); box-shadow: var(--shadow-card); margin-bottom: var(--sp-gap); animation: bk-rise var(--motion-base) var(--ease-out) both; }
.dc-card::before { content: ''; position: absolute; left: var(--sp-card); top: 0; width: 96rpx; height: 6rpx; border-radius: 0 0 var(--r-pill) var(--r-pill); background: var(--c-primary); }

.dc-head { display: flex; align-items: flex-start; justify-content: space-between; }
.dc-title { flex: 1; font-size: var(--fs-title); font-weight: 800; letter-spacing: -1rpx; color: var(--c-ink); }
.dc-badge { flex: none; margin-left: var(--sp-sm); font-size: var(--fs-pill); font-weight: 600; padding: 6rpx var(--sp-sm); border-radius: var(--r-pill); background: var(--c-surface-2); color: var(--c-text-2); }
.dc-badge.conf-low { background: var(--c-warn-weak); color: var(--c-warn); }
.dc-badge.conf-high { background: var(--c-success-weak); color: var(--c-success); }

.dc-tags { display: flex; flex-wrap: wrap; margin: var(--sp-sm) 0 var(--sp-gap); }
.dc-tag { font-size: var(--fs-pill); background: var(--c-surface-2); color: var(--c-text-2); border-radius: var(--r-pill); padding: 6rpx var(--sp-sm); margin: 0 var(--sp-xs) var(--sp-xs) 0; }
.dc-unverified { margin: 0 0 var(--sp-gap); padding: var(--sp-sm) var(--sp-gap); border-radius: var(--r-btn); background: var(--c-warn-weak); color: var(--c-warn); font-size: var(--fs-hint); line-height: var(--lh-body); }
.dc-price-note { margin: 0 0 var(--sp-gap); font-size: var(--fs-hint); color: var(--c-text-3); line-height: var(--lh-body); }

.dc-rec { background: var(--c-surface-2); border-radius: var(--r-btn); padding: var(--sp-gap); margin-bottom: var(--sp-sm); animation: bk-rise var(--motion-base) var(--ease-out) both; }
.dc-rec-0 { animation-delay: 40ms; }
.dc-rec-1 { animation-delay: 100ms; }
.dc-rec-type { display: inline-block; font-size: var(--fs-pill); font-weight: 700; background: var(--c-primary-soft); color: var(--c-primary-press); border-radius: var(--r-pill); padding: 4rpx var(--sp-sm); }
.dc-rec-name { font-size: var(--fs-body); font-weight: 700; color: var(--c-ink); margin-top: var(--sp-sm); }
.dc-rec-price { display: flex; align-items: center; font-size: var(--fs-title); font-weight: 800; letter-spacing: -1rpx; color: var(--c-primary-press); margin: var(--sp-xs) 0 var(--sp-sm); }
.dc-price-val { flex: none; }
/* 估算标：价格是品类行情推算的，必须和真实报价区分开 */
.dc-price-tag { flex: none; margin-left: 10rpx; padding: 2rpx 10rpx; border: 1rpx solid var(--c-line); border-radius: 6rpx; background: var(--c-bg-warm); color: var(--c-text-3); font-size: var(--fs-pill); font-weight: 600; letter-spacing: 0; transform: translateY(2rpx); }
.dc-rec-line { min-height: 88rpx; box-sizing: border-box; padding: var(--sp-xs) 0; font-size: var(--fs-hint); color: var(--c-text-2); line-height: var(--lh-body); }
.dc-clamp { overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }

.dc-flags { background: var(--c-danger-weak); border-left: 4rpx solid var(--c-danger); border-radius: 0 var(--r-btn) var(--r-btn) 0; padding: var(--sp-gap); margin: var(--sp-gap) 0; }
.dc-flags-title { display: flex; align-items: center; font-size: var(--fs-body); font-weight: 700; color: var(--c-danger-press); }
.dc-flag-icon { display: inline-flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; border-radius: var(--r-pill); background: var(--c-danger); color: var(--c-on-danger); font-size: var(--fs-pill); font-weight: 700; margin-right: var(--sp-xs); }
.dc-flag { font-size: var(--fs-body); color: var(--c-text-2); margin-top: var(--sp-sm); line-height: var(--lh-body); }

.dc-keyword { background: var(--c-bg-warm); border: 1rpx solid var(--c-line); border-radius: var(--r-btn); padding: var(--sp-sm) var(--sp-gap); }
.dc-keyword-label { font-size: var(--fs-pill); color: var(--c-text-3); letter-spacing: 2rpx; }
.dc-keyword-row { display: flex; align-items: center; }
.dc-keyword-text { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: var(--fs-body); color: var(--c-ink); }
.dc-copy { flex: none; min-height: 88rpx; margin-left: var(--sp-sm); padding: 0 var(--sp-gap); font-size: var(--fs-pill); font-weight: 600; color: var(--c-primary-press); background: var(--c-primary-soft); border-radius: var(--r-pill); }

.dc-refs { border-top: 1rpx dashed var(--c-line); padding-top: var(--sp-sm); margin-top: var(--sp-gap); font-size: var(--fs-hint); color: var(--c-text-3); }
.dc-refs-label { margin-right: var(--sp-xs); }
.dc-ref { display: inline-flex; align-items: center; min-height: 88rpx; margin-right: var(--sp-sm); color: var(--c-text-2); text-decoration: underline; }
.dc-disclaimer { border-top: 1rpx solid var(--c-line); padding-top: var(--sp-sm); margin-top: var(--sp-gap); font-size: var(--fs-hint); color: var(--c-text-3); text-align: center; }

.dc-actions { animation: bk-fade var(--motion-base) var(--ease-out) both; }
.dc-btn-primary { width: 100%; min-height: 96rpx; background: var(--c-primary); color: var(--c-on-primary); font-size: var(--fs-body); font-weight: 700; letter-spacing: 2rpx; border-radius: var(--r-btn); }
.dc-btn-row { display: flex; justify-content: space-between; margin-top: var(--sp-sm); }
.dc-btn-ghost { width: 31%; min-height: 88rpx; font-size: var(--fs-hint); color: var(--c-text-2); background: var(--c-card); border: 1rpx solid var(--c-line); border-radius: var(--r-btn); }

.dc-skeleton { background: var(--c-card); border-radius: var(--r-card); padding: var(--sp-card); box-shadow: var(--shadow-card); }
.dc-sk-line, .dc-sk-block { background-image: linear-gradient(90deg, var(--c-skeleton) 20%, var(--c-shimmer) 50%, var(--c-skeleton) 80%); background-size: 640rpx 100%; animation: bk-shimmer 1.4s linear infinite; border-radius: var(--r-btn); }
.dc-sk-line { height: 28rpx; width: 70%; margin-bottom: var(--sp-sm); }
.dc-sk-title { width: 90%; height: 48rpx; }
.dc-sk-block { height: 160rpx; margin-bottom: var(--sp-sm); }

.dc-degraded { background: var(--c-card); border-radius: var(--r-card); padding: var(--sp-card); box-shadow: var(--shadow-card); animation: bk-rise var(--motion-base) var(--ease-out) both; }
.dc-degraded-title { font-size: var(--fs-title); font-weight: 800; color: var(--c-warn); }
.dc-degraded-desc { font-size: var(--fs-hint); color: var(--c-text-3); margin: var(--sp-sm) 0 var(--sp-gap); }
.dc-degraded-code { margin: 0 0 var(--sp-xs); font-size: var(--fs-pill); color: var(--c-text-3); }
.dc-degraded-detail { margin: 0 0 var(--sp-gap); font-size: var(--fs-pill); color: var(--c-text-3); word-break: break-all; opacity: .8; }
.dc-degraded-line { position: relative; padding-left: var(--sp-sm); border-left: 4rpx solid var(--c-warn-weak); margin-bottom: var(--sp-sm); font-size: var(--fs-body); color: var(--c-text-2); line-height: var(--lh-body); }
.dc-retry { width: 100%; min-height: 88rpx; margin-top: var(--sp-gap); background: var(--c-card); color: var(--c-primary-press); border: 2rpx solid var(--c-primary); border-radius: var(--r-btn); font-size: var(--fs-body); font-weight: 600; }
.dc-empty { text-align: center; padding: var(--sp-lg); color: var(--c-text-3); font-size: var(--fs-hint); }

.dc-readonly .dc-actions { display: none; }
.is-pressed { transform: scale(.965); opacity: .88; }
