/* 胶囊标签：亮色选中态，按下有形变 */
.tp-root { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; min-height: 88rpx; padding: 0 var(--sp-gap); font-size: var(--fs-pill); font-weight: 600; border-radius: var(--r-pill); background: var(--c-primary-soft); color: var(--c-primary-press); transition: transform var(--motion-fast) var(--ease-spring), opacity var(--motion-fast) var(--ease-out); }
.tp-warn { background: var(--c-warn-weak); color: var(--c-warn); }
