/* 查证半屏面板：底部上滑 300ms，内容做浅底分组 */
.vs-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: var(--c-mask); z-index: 100; animation: bk-fade var(--motion-fast) var(--ease-out) both; }
.vs-panel { position: absolute; left: 0; right: 0; bottom: 0; box-sizing: border-box; max-height: 76vh; overflow-y: auto; background: var(--c-bg-warm); border-radius: var(--r-card) var(--r-card) 0 0; padding: var(--sp-card); animation: bk-sheet-up var(--motion-sheet) var(--ease-out) both; }
.vs-handle { width: 88rpx; height: 8rpx; border-radius: var(--r-pill); background: var(--c-line); margin: 0 auto var(--sp-gap); }
.vs-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--sp-gap); }
.vs-title { font-size: var(--fs-title); font-weight: 800; color: var(--c-ink); }
.vs-close { min-height: 88rpx; display: flex; align-items: center; font-size: var(--fs-hint); color: var(--c-text-3); padding: 0 var(--sp-sm); }

.vs-loading, .vs-tip { background: var(--c-card); border-radius: var(--r-btn); padding: var(--sp-gap); text-align: center; font-size: var(--fs-body); color: var(--c-text-2); }
.vs-loading { background-image: linear-gradient(90deg, var(--c-card) 20%, var(--c-surface-2) 50%, var(--c-card) 80%); background-size: 640rpx 100%; animation: bk-shimmer 1.4s linear infinite; }

.vs-body { background: var(--c-card); border-radius: var(--r-card); padding: var(--sp-card); box-shadow: var(--shadow-card); }
.vs-verdict { font-size: var(--fs-body); font-weight: 700; color: var(--c-ink); line-height: var(--lh-body); padding-bottom: var(--sp-sm); border-bottom: 1rpx solid var(--c-line); }
.vs-feedback { background: var(--c-surface-2); border-radius: var(--r-btn); padding: var(--sp-sm) var(--sp-gap); margin-top: var(--sp-sm); font-size: var(--fs-hint); color: var(--c-text-2); line-height: var(--lh-body); animation: bk-rise var(--motion-base) var(--ease-out) both; }
.vs-caution { background: var(--c-danger-weak); border-left: 4rpx solid var(--c-danger); border-radius: 0 var(--r-btn) var(--r-btn) 0; padding: var(--sp-sm) var(--sp-gap); margin-top: var(--sp-gap); font-size: var(--fs-hint); color: var(--c-danger-press); }
.vs-sources { margin-top: var(--sp-gap); font-size: var(--fs-pill); color: var(--c-text-3); }
.vs-source { display: inline-block; background: var(--c-surface-2); border-radius: var(--r-pill); padding: 4rpx var(--sp-sm); margin: var(--sp-xs) var(--sp-xs) 0 0; color: var(--c-text-2); }
