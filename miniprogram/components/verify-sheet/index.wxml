<view wx:if="{{visible}}" class="vs-mask" bindtap="onClose">
  <view class="vs-panel" catchtap="noop">
    <view class="vs-handle"></view>
    <view class="vs-head">
      <text class="vs-title">全网真实口碑</text>
      <text class="vs-close" bindtap="onClose">关闭</text>
    </view>

    <view wx:if="{{state === 'loading'}}" class="vs-loading">正在检索全网口碑…</view>
    <view wx:elif="{{state === 'degraded'}}" class="vs-tip">当前检索繁忙，先看基础决策</view>
    <view wx:elif="{{state === 'empty'}}" class="vs-tip">暂未检索到有效口碑，换基础决策看看</view>
    <view wx:else class="vs-body">
      <view class="vs-verdict">{{summary.recent_verdict}}</view>
      <view wx:for="{{feedback}}" wx:key="*this" class="vs-feedback">· {{item}}</view>
      <view wx:if="{{summary.caution_alert}}" class="vs-caution">注意：{{summary.caution_alert}}</view>
      <view wx:if="{{sources.length}}" class="vs-sources">
        来源：<text wx:for="{{sources}}" wx:key="*this" class="vs-source">{{item}}</text>
      </view>
    </view>
  </view>
</view>
