<view class="page-result">
  <view wx:if="{{demoMode}}" class="res-demo-bar">演示模式 · 数据为预置样例</view>

  <decision-card wx:if="{{state !== 'empty'}}" card="{{card}}" state="{{state}}" showRefs="{{showRefs}}"
    error-code="{{errorCode}}" error-text="{{errorText}}" error-detail="{{errorDetail}}"
    ext-class="{{readonly ? 'dc-readonly' : ''}}"
    bind:copykeyword="onCopyKeyword" bind:verify="onVerify" bind:save="onSave"
    bind:share="onShare" bind:report="onReport" bind:retry="onRetry" />

  <state-view wx:else state="empty" title="还没有决策卡" desc="回到首页问一句，就会生成"
    action-text="回首页" bind:retry="goHome" />

  <verify-sheet visible="{{verifyVisible}}" data="{{verifyData}}" state="{{verifyState}}"
    bind:close="onCloseVerify" />
</view>
