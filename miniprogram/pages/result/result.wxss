/* 结果页：给决策卡留出奶油底呼吸空间 */
.page-result { min-height: 100vh; box-sizing: border-box; padding: var(--sp-card) var(--sp-card) var(--sp-lg); }
.res-demo-bar { background: var(--c-warn-weak); color: var(--c-warn); font-size: var(--fs-hint); font-weight: 600; text-align: center; padding: var(--sp-sm); border-radius: var(--r-btn); margin-bottom: var(--sp-gap); animation: bk-fade var(--motion-base) var(--ease-out) both; }
.dc-readonly .dc-actions { display: none; }
