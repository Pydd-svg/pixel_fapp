/* 结果页样式占位 —— 归属 C 岗 */
.res { padding: 24rpx; }
.res__degrade { display: flex; align-items: center; justify-content: space-between; background: #FFF7ED; border-radius: 12rpx; padding: 16rpx 20rpx; margin-bottom: 16rpx; }
.res__degrade-text { font-size: 24rpx; color: #C2410C; flex: 1; }
.res__degrade-retry { font-size: 24rpx; color: #C2410C; text-decoration: underline; padding-left: 16rpx; }
