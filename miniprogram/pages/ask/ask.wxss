/* 第 1 步「问一句」页：分区标题 / 品类胶囊 / 必读倒计时 / 输入卡 / 引导条 / 通栏按钮 */
.page-ask {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--sp-card) var(--sp-card) 60rpx;
}

.ax-demo {
  margin-bottom: var(--sp-gap);
  padding: var(--sp-sm);
  border-radius: var(--r-btn);
  background: var(--c-warn-weak);
  color: var(--c-warn);
  font-size: var(--fs-hint);
  font-weight: 600;
  text-align: center;
  animation: bk-fade var(--motion-base) var(--ease-out) both;
}

/* 分区标题 */
.ax-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ax-section-title {
  font-size: var(--fs-body);
  font-weight: 800;
  color: var(--c-ink);
}

.ax-section-title::before {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 28rpx;
  margin-right: var(--sp-xs);
  vertical-align: -4rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary);
}

.ax-section-more {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 var(--sp-sm);
  font-size: var(--fs-hint);
  color: var(--c-primary-press);
}

/* 品类胶囊 */
.ax-quick-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: var(--sp-sm);
}

.ax-tag-wrap {
  min-height: 88rpx;
  margin: 0 var(--sp-sm) var(--sp-sm) 0;
}

/* 必读卡：与胶囊拉开距离；消退后这段留白也一并收掉 */
.ax-gate {
  display: block;
  margin-bottom: var(--sp-gap);
  transition: margin-bottom var(--motion-base) var(--ease-out);
}

.ax-gate.is-gone {
  margin-bottom: 0;
}

/* 输入卡 */
.ax-input-card {
  padding: var(--sp-card);
  border-radius: var(--r-card);
  background: var(--c-card);
  box-shadow: var(--shadow-card);
  animation: bk-rise var(--motion-base) var(--ease-out) 120ms both;
}

.ax-input-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sp-sm);
}

.ax-input-label {
  font-size: var(--fs-body);
  font-weight: 700;
  color: var(--c-ink);
}

.ax-input-badge {
  padding: 4rpx var(--sp-sm);
  border-radius: var(--r-pill);
  background: var(--c-primary-soft);
  color: var(--c-primary-press);
  font-size: var(--fs-pill);
  font-weight: 700;
}

.ax-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 220rpx;
  padding: var(--sp-gap);
  border-radius: var(--r-btn);
  background: var(--c-surface-2);
  font-size: var(--fs-body);
  color: var(--c-ink);
}

.ax-input-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--sp-sm);
}

.ax-input-tip,
.ax-input-limit {
  font-size: var(--fs-pill);
  color: var(--c-text-3);
}

/* 引导去第 2 步 */
.ax-tip {
  display: flex;
  align-items: center;
  margin-top: var(--sp-gap);
  padding: var(--sp-sm) var(--sp-gap);
  border-radius: var(--r-btn);
  background: var(--c-primary-weak);
}

.ax-tip-dot {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-right: var(--sp-sm);
  border-radius: var(--r-pill);
  background: var(--c-primary-press);
}

.ax-tip-body { flex: 1; }

.ax-tip-title {
  display: block;
  font-size: var(--fs-hint);
  font-weight: 700;
  color: var(--c-primary-press);
}

.ax-tip-desc {
  display: block;
  margin-top: 2rpx;
  font-size: var(--fs-pill);
  color: var(--c-text-2);
}

.ax-tip-go {
  padding-left: var(--sp-sm);
  font-size: var(--fs-body);
  color: var(--c-primary-press);
}

/* 通栏主按钮 */
.ax-send {
  width: 100%;
  min-height: 104rpx;
  margin-top: var(--sp-gap);
  border-radius: var(--r-card);
  background: var(--c-primary);
  color: var(--c-on-primary);
  box-shadow: var(--shadow-card);
  font-size: var(--fs-body);
  font-weight: 800;
  letter-spacing: 2rpx;
}

.ax-send[disabled] { opacity: .55; }

.ax-send-note {
  margin-top: var(--sp-sm);
  text-align: center;
  font-size: var(--fs-pill);
  color: var(--c-text-3);
}

/* 追问态 */
.ax-chat-card {
  padding: var(--sp-card);
  border-radius: var(--r-card);
  background: var(--c-card);
  box-shadow: var(--shadow-card);
  animation: bk-rise var(--motion-base) var(--ease-out) both;
}

.ax-chat-label {
  padding-bottom: var(--sp-sm);
  border-bottom: 1rpx solid var(--c-line);
  font-size: var(--fs-hint);
  color: var(--c-text-3);
  letter-spacing: 2rpx;
}

.ax-chat {
  display: flex;
  flex-direction: column;
  padding: var(--sp-gap) 0 0;
}

.ax-bubble {
  max-width: 82%;
  margin-bottom: var(--sp-gap);
  padding: var(--sp-sm) var(--sp-gap);
  border-radius: var(--r-card);
  font-size: var(--fs-body);
  animation: bk-rise var(--motion-base) var(--ease-out) both;
}

.ax-bubble-user {
  align-self: flex-end;
  background: var(--c-primary-soft);
  color: var(--c-ink);
}

.ax-bubble-assistant {
  align-self: flex-start;
  background: var(--c-surface-2);
}

.ax-input-sticky {
  display: flex;
  align-items: center;
  margin-top: var(--sp-gap);
  padding: var(--sp-sm);
}

.ax-input-single {
  flex: 1;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 var(--sp-gap);
  border-radius: var(--r-btn);
  background: var(--c-surface-2);
  font-size: var(--fs-body);
  color: var(--c-ink);
}

.ax-input-sticky .ax-send {
  flex: none;
  width: 176rpx;
  min-height: 88rpx;
  margin: 0 0 0 var(--sp-sm);
  box-shadow: none;
}

/* ---------- 流式预览卡 ---------- */
.ax-live {
  margin-bottom: var(--sp-gap);
  padding: var(--sp-card);
  background: var(--c-card);
  border: 2rpx solid var(--c-line);
  border-radius: var(--r-card);
  animation: bk-rise var(--motion-base) var(--ease-out) both;
}

.ax-live-label {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: var(--c-text-3);
  margin-bottom: var(--sp-sm);
}

.ax-live-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--c-text-1);
}

.ax-live-flag {
  display: flex;
  align-items: flex-start;
  margin-top: var(--sp-sm);
}

.ax-live-dot {
  flex: none;
  width: 10rpx;
  height: 10rpx;
  margin: 14rpx 12rpx 0 0;
  border-radius: 50%;
  background: var(--c-danger);
  animation: ax-live-pulse 1.2s ease-in-out infinite;
}

.ax-live-flag-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--c-text-2);
}

.ax-live-bar {
  height: 6rpx;
  margin-top: var(--sp-gap);
  border-radius: 999px;
  background: linear-gradient(90deg, var(--c-primary-weak), var(--c-primary), var(--c-primary-weak));
  background-size: 200% 100%;
  animation: ax-live-sweep 1.1s linear infinite;
}

@keyframes ax-live-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .3; }
}

@keyframes ax-live-sweep {
  0% { background-position: 0 0; }
  100% { background-position: -200% 0; }
}
