/* 首页：品牌行 / 日期问候 / 周历 / 两步入口卡 / 浅绿数据卡 / 最近看过 / 双入口
   色值一律走 tokens.wxss，页面内不出现硬编码颜色 */
.page-index {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--sp-card) var(--sp-card) 60rpx;
}

.idx-demo-bar {
  margin-bottom: var(--sp-gap);
  padding: var(--sp-sm);
  border-radius: var(--r-btn);
  background: var(--c-warn-weak);
  color: var(--c-warn);
  font-size: var(--fs-hint);
  font-weight: 600;
  text-align: center;
  animation: bk-fade var(--motion-base) var(--ease-out) both;
}

/* 品牌行 */
.idx-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-xs) 0 var(--sp-gap);
  animation: bk-fade var(--motion-base) var(--ease-out) both;
}

.idx-brand { display: flex; align-items: center; }

.idx-brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin-right: var(--sp-sm);
  border-radius: var(--r-btn);
  background: var(--c-primary);
  color: var(--c-on-primary);
  font-size: var(--fs-body);
  font-weight: 800;
}

.idx-brand-name {
  font-size: var(--fs-body);
  font-weight: 800;
  letter-spacing: 2rpx;
  color: var(--c-ink);
}

.idx-topbar-pill {
  display: flex;
  align-items: center;
  min-height: 48rpx;
  padding: 0 var(--sp-sm);
  border-radius: var(--r-pill);
  background: var(--c-card);
  color: var(--c-text-3);
  font-size: var(--fs-pill);
  font-weight: 700;
  letter-spacing: 2rpx;
}

/* 日期与问候 */
.idx-hello {
  padding: var(--sp-sm) 0 var(--sp-gap);
  animation: bk-rise var(--motion-base) var(--ease-out) both;
}

.idx-hello-date { font-size: var(--fs-hint); color: var(--c-text-3); letter-spacing: 2rpx; }

.idx-hello-title {
  margin-top: var(--sp-sm);
  font-size: var(--fs-display);
  line-height: 1.3;
  font-weight: 800;
  letter-spacing: -2rpx;
  color: var(--c-ink);
}

.idx-hello-em { color: var(--c-primary-press); }

.idx-hello-sub { margin-top: var(--sp-sm); font-size: var(--fs-hint); color: var(--c-text-2); }

/* 周历横排 */
.idx-week {
  display: flex;
  padding: var(--sp-sm) var(--sp-xs);
  border-radius: var(--r-card);
  background: var(--c-card);
  box-shadow: var(--shadow-card);
  animation: bk-rise var(--motion-base) var(--ease-out) 40ms both;
}

.idx-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-sm) 0;
  border-radius: var(--r-btn);
}

.idx-day-label { font-size: var(--fs-pill); color: var(--c-text-3); }
.idx-day-num { margin-top: var(--sp-xs); font-size: var(--fs-body); font-weight: 700; color: var(--c-ink); }

.idx-day-dot {
  width: 8rpx;
  height: 8rpx;
  margin-top: var(--sp-xs);
  border-radius: var(--r-pill);
  background: var(--c-primary-press);
}

.idx-day-on { background: var(--c-primary); }
.idx-day-on .idx-day-label,
.idx-day-on .idx-day-num { color: var(--c-on-primary); }
.idx-day-on .idx-day-dot { background: var(--c-on-primary); }

/* 两步入口卡：深墨底 + 柠檬绿圆箭头 */
.hm-step {
  display: flex;
  align-items: center;
  margin-top: var(--sp-gap);
  padding: var(--sp-card);
  border-radius: var(--r-card);
  background: var(--c-ink);
  /* backwards：both 会锁死 transform，导致按下的 scale 失效 */
  animation: bk-rise var(--motion-base) var(--ease-out) 80ms backwards;
}

.hm-step-2 { animation-delay: 120ms; }

.hm-step-main { flex: 1; min-width: 0; }

.hm-step-badge {
  display: inline-block;
  padding: 4rpx var(--sp-sm);
  border-radius: var(--r-pill);
  background: var(--c-primary);
  color: var(--c-on-primary);
  font-size: var(--fs-pill);
  font-weight: 700;
}

.hm-step-title {
  margin-top: var(--sp-sm);
  font-size: var(--fs-title);
  font-weight: 800;
  line-height: 1.25;
  letter-spacing: -1rpx;
  color: var(--c-on-dark);
}

.hm-step-desc {
  margin-top: 6rpx;
  font-size: var(--fs-pill);
  line-height: 1.5;
  color: var(--c-on-dark-dim);
}

.hm-step-go {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  margin-left: var(--sp-gap);
  border-radius: var(--r-pill);
  background: var(--c-primary);
  color: var(--c-on-primary);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1;
}

/* 档案入口卡：结构与上面两张完全一致，只把标题换成"数字 + 单位" */
.hm-step-3 { animation-delay: 160ms; }

.hm-step-3 .hm-step-title { display: flex; align-items: baseline; }

.idx-stat-num {
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -1rpx;
  color: var(--c-on-dark);
}

.idx-stat-unit {
  margin-left: var(--sp-xs);
  font-size: var(--fs-pill);
  font-weight: 600;
  color: var(--c-on-dark-dim);
}

/* 最近看过 */
.idx-list {
  margin-top: var(--sp-gap);
  padding: 0 var(--sp-card);
  border-radius: var(--r-card);
  background: var(--c-card);
  box-shadow: var(--shadow-card);
  animation: bk-rise var(--motion-base) var(--ease-out) 200ms both;
}

.idx-list-row {
  display: flex;
  align-items: center;
  min-height: 128rpx;
  padding: var(--sp-sm) 0;
  border-bottom: 1rpx solid var(--c-line);
}

.idx-list-row-last { border-bottom: none; }

.idx-list-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  margin-right: var(--sp-sm);
  border-radius: var(--r-btn);
  font-size: var(--fs-body);
  font-weight: 800;
}

.idx-list-icon-a { background: var(--c-primary); color: var(--c-on-primary); }
.idx-list-body { flex: 1; }
.idx-list-title { font-size: var(--fs-body); font-weight: 700; color: var(--c-ink); }
.idx-list-desc { margin-top: 4rpx; font-size: var(--fs-pill); color: var(--c-text-3); }
.idx-list-arrow { padding-left: var(--sp-sm); font-size: var(--fs-title); color: var(--c-text-3); }

/* 底部双入口 */
.idx-dock {
  display: flex;
  align-items: center;
  margin-top: var(--sp-lg);
  padding: var(--sp-sm) var(--sp-gap);
  border-radius: var(--r-card);
  background: var(--c-card);
  box-shadow: var(--shadow-card);
  animation: bk-rise var(--motion-base) var(--ease-out) 240ms both;
}

.idx-dock-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--sp-xs) 0;
}

.idx-dock-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-pill);
  background: var(--c-primary);
  color: var(--c-on-primary);
  font-size: var(--fs-hint);
  font-weight: 800;
}

.idx-dock-icon-b { background: var(--c-primary-weak); color: var(--c-primary-press); }

.idx-dock-text {
  margin-top: var(--sp-xs);
  font-size: var(--fs-pill);
  color: var(--c-text-2);
  font-weight: 700;
}
