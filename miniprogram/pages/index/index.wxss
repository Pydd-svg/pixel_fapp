/* 首页：品牌行 / 日期问候 / 周历 / 浅绿数据卡 / 胶囊 / 输入卡 / 列表卡 / 通栏按钮 / 图标行
   色值一律走 tokens.wxss，页面内不出现硬编码颜色 */
.page-index { min-height: 100vh; box-sizing: border-box; padding: var(--sp-card) var(--sp-card) 180rpx; }

.idx-demo-bar { background: var(--c-warn-weak); color: var(--c-warn); font-size: var(--fs-hint); font-weight: 600; text-align: center; padding: var(--sp-sm); border-radius: var(--r-btn); margin-bottom: var(--sp-gap); animation: bk-fade var(--motion-base) var(--ease-out) both; }

/* 品牌行 */
.idx-topbar { display: flex; align-items: center; justify-content: space-between; padding: var(--sp-xs) 0 var(--sp-gap); animation: bk-fade var(--motion-base) var(--ease-out) both; }
.idx-brand { display: flex; align-items: center; }
.idx-brand-mark { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-right: var(--sp-sm); border-radius: var(--r-btn); background: var(--c-primary); color: var(--c-on-primary); font-size: var(--fs-body); font-weight: 800; }
.idx-brand-name { font-size: var(--fs-body); font-weight: 800; letter-spacing: 2rpx; color: var(--c-ink); }
.idx-topbar-pill { display: flex; align-items: center; min-height: 48rpx; padding: 0 var(--sp-sm); border-radius: var(--r-pill); background: var(--c-card); color: var(--c-text-3); font-size: var(--fs-pill); font-weight: 700; letter-spacing: 2rpx; }

/* 日期与问候 */
.idx-hello { padding: var(--sp-sm) 0 var(--sp-gap); animation: bk-rise var(--motion-base) var(--ease-out) both; }
.idx-hello-date { font-size: var(--fs-hint); color: var(--c-text-3); letter-spacing: 2rpx; }
.idx-hello-title { margin-top: var(--sp-sm); font-size: var(--fs-display); line-height: 1.3; font-weight: 800; letter-spacing: -2rpx; color: var(--c-ink); }
.idx-hello-em { color: var(--c-primary-press); }
.idx-hello-sub { margin-top: var(--sp-sm); font-size: var(--fs-hint); color: var(--c-text-2); }

/* 周历横排 */
.idx-week { display: flex; padding: var(--sp-sm) var(--sp-xs); background: var(--c-card); border-radius: var(--r-card); box-shadow: var(--shadow-card); animation: bk-rise var(--motion-base) var(--ease-out) 40ms both; }
.idx-day { flex: 1; display: flex; flex-direction: column; align-items: center; padding: var(--sp-sm) 0; border-radius: var(--r-btn); }
.idx-day-label { font-size: var(--fs-pill); color: var(--c-text-3); }
.idx-day-num { margin-top: var(--sp-xs); font-size: var(--fs-body); font-weight: 700; color: var(--c-ink); }
.idx-day-dot { width: 8rpx; height: 8rpx; margin-top: var(--sp-xs); border-radius: var(--r-pill); background: var(--c-primary-press); }
.idx-day-on { background: var(--c-primary); }
.idx-day-on .idx-day-label, .idx-day-on .idx-day-num { color: var(--c-on-primary); }
.idx-day-on .idx-day-dot { background: var(--c-on-primary); }

/* 浅绿数据卡 */
.idx-stat { position: relative; display: flex; align-items: center; overflow: hidden; margin-top: var(--sp-gap); padding: var(--sp-card); border-radius: var(--r-card); background: var(--c-primary-weak); animation: bk-rise var(--motion-base) var(--ease-out) 80ms both; }
.idx-stat-main { position: relative; z-index: 1; flex: 1; }
.idx-stat-caption { font-size: var(--fs-hint); font-weight: 600; letter-spacing: 2rpx; color: var(--c-primary-press); }
.idx-stat-num { margin-top: var(--sp-xs); font-size: var(--fs-num); line-height: 1.1; font-weight: 800; color: var(--c-ink); }
.idx-stat-unit { margin-left: var(--sp-xs); font-size: var(--fs-hint); font-weight: 600; color: var(--c-text-2); }
.idx-stat-note { margin-top: var(--sp-sm); font-size: var(--fs-pill); color: var(--c-text-2); }
.idx-stat-art { position: absolute; right: -40rpx; top: -40rpx; width: 220rpx; height: 220rpx; }
.idx-stat-orbit { position: absolute; left: 0; top: 0; box-sizing: border-box; width: 220rpx; height: 220rpx; border: 24rpx solid var(--c-primary-ring); border-radius: var(--r-pill); }
.idx-stat-core { position: absolute; left: 70rpx; top: 70rpx; width: 80rpx; height: 80rpx; border-radius: var(--r-pill); background: var(--c-primary); }

/* 分区标题 + 胶囊 */
.idx-section { display: flex; align-items: center; justify-content: space-between; margin-top: var(--sp-lg); }
.idx-section-title { font-size: var(--fs-body); font-weight: 800; color: var(--c-ink); }
.idx-section-title::before { content: ''; display: inline-block; width: 10rpx; height: 28rpx; margin-right: var(--sp-xs); vertical-align: -4rpx; border-radius: var(--r-pill); background: var(--c-primary); }
.idx-section-more { display: flex; align-items: center; min-height: 88rpx; padding: 0 var(--sp-sm); font-size: var(--fs-hint); color: var(--c-primary-press); }
.idx-quick-tags, .idx-quick-replies { display: flex; flex-wrap: wrap; margin-top: var(--sp-sm); }
.idx-tag-wrap { min-height: 88rpx; margin: 0 var(--sp-sm) var(--sp-sm) 0; }

/* 输入卡 */
.idx-input-card { margin-top: var(--sp-sm); padding: var(--sp-card); border-radius: var(--r-card); background: var(--c-card); box-shadow: var(--shadow-card); animation: bk-rise var(--motion-base) var(--ease-out) 120ms both; }
.idx-input-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--sp-sm); }
.idx-input-label { font-size: var(--fs-body); font-weight: 700; color: var(--c-ink); }
.idx-input-badge { padding: 4rpx var(--sp-sm); border-radius: var(--r-pill); background: var(--c-primary-soft); color: var(--c-primary-press); font-size: var(--fs-pill); font-weight: 700; }
.idx-input { box-sizing: border-box; width: 100%; min-height: 180rpx; padding: var(--sp-sm) var(--sp-gap); border-radius: var(--r-btn); background: var(--c-surface-2); font-size: var(--fs-body); color: var(--c-ink); }
.idx-input-foot { display: flex; align-items: center; justify-content: space-between; margin-top: var(--sp-sm); }
.idx-input-tip, .idx-input-limit { font-size: var(--fs-pill); color: var(--c-text-3); }

/* 列表卡 */
.idx-list { margin-top: var(--sp-gap); padding: 0 var(--sp-card); border-radius: var(--r-card); background: var(--c-card); box-shadow: var(--shadow-card); animation: bk-rise var(--motion-base) var(--ease-out) 160ms both; }
.idx-list-row { display: flex; align-items: center; min-height: 128rpx; padding: var(--sp-sm) 0; border-bottom: 1rpx solid var(--c-line); }
.idx-list-row-last { border-bottom: none; }
.idx-list-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 72rpx; height: 72rpx; margin-right: var(--sp-sm); border-radius: var(--r-btn); font-size: var(--fs-body); font-weight: 800; }
.idx-list-icon-a { background: var(--c-primary); color: var(--c-on-primary); }
.idx-list-icon-b { background: var(--c-warn-weak); color: var(--c-warn); }
.idx-list-icon-c { background: var(--c-surface-2); color: var(--c-text-2); }
.idx-list-body { flex: 1; }
.idx-list-title { font-size: var(--fs-body); font-weight: 700; color: var(--c-ink); }
.idx-list-desc { margin-top: 4rpx; font-size: var(--fs-pill); color: var(--c-text-3); }
.idx-list-arrow { padding-left: var(--sp-sm); font-size: var(--fs-title); color: var(--c-text-3); }

/* 通栏主按钮 */
.idx-send { width: 100%; min-height: 104rpx; margin-top: var(--sp-gap); border-radius: var(--r-card); background: var(--c-primary); color: var(--c-on-primary); box-shadow: var(--shadow-card); font-size: var(--fs-body); font-weight: 800; letter-spacing: 2rpx; animation: bk-rise var(--motion-base) var(--ease-out) 200ms both; }
.idx-send[disabled] { opacity: .6; }
.idx-send-note { margin-top: var(--sp-sm); text-align: center; font-size: var(--fs-pill); color: var(--c-text-3); }

/* 底部图标导航行 */
.idx-dock { display: flex; align-items: center; justify-content: space-between; margin-top: var(--sp-lg); padding: var(--sp-sm) var(--sp-gap); border-radius: var(--r-card); background: var(--c-card); box-shadow: var(--shadow-card); animation: bk-rise var(--motion-base) var(--ease-out) 240ms both; }
.idx-dock-item { flex: 1; display: flex; flex-direction: column; align-items: center; padding: var(--sp-xs) 0; }
.idx-dock-icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: var(--r-pill); background: var(--c-surface-2); color: var(--c-text-2); font-size: var(--fs-hint); font-weight: 800; }
.idx-dock-on .idx-dock-icon { background: var(--c-primary); color: var(--c-on-primary); }
.idx-dock-icon-b { background: var(--c-primary-weak); color: var(--c-primary-press); }
.idx-dock-icon-c { background: var(--c-warn-weak); color: var(--c-warn); }
.idx-dock-icon-d { background: var(--c-success-weak); color: var(--c-success); }
.idx-dock-text { margin-top: var(--sp-xs); font-size: var(--fs-pill); color: var(--c-text-3); }
.idx-dock-on .idx-dock-text { color: var(--c-ink); font-weight: 700; }

/* 追问态 */
.idx-chat-card { padding: var(--sp-card); border-radius: var(--r-card); background: var(--c-card); box-shadow: var(--shadow-card); animation: bk-rise var(--motion-base) var(--ease-out) both; }
.idx-chat-label { padding-bottom: var(--sp-sm); border-bottom: 1rpx solid var(--c-line); font-size: var(--fs-hint); color: var(--c-text-3); letter-spacing: 2rpx; }
.idx-chat { display: flex; flex-direction: column; padding: var(--sp-gap) 0 0; }
.idx-bubble { max-width: 82%; margin-bottom: var(--sp-gap); padding: var(--sp-sm) var(--sp-gap); border-radius: var(--r-card); font-size: var(--fs-body); animation: bk-rise var(--motion-base) var(--ease-out) both; }
.idx-bubble-user { align-self: flex-end; background: var(--c-primary-soft); color: var(--c-ink); }
.idx-bubble-assistant { align-self: flex-start; background: var(--c-surface-2); }
.idx-quick-replies { margin-top: var(--sp-sm); }
.idx-input-sticky { display: flex; align-items: center; padding: var(--sp-sm); }
.idx-input-single { flex: 1; box-sizing: border-box; min-height: 88rpx; padding: 0 var(--sp-gap); border-radius: var(--r-btn); background: var(--c-surface-2); font-size: var(--fs-body); color: var(--c-ink); }
.idx-input-sticky .idx-send { flex: none; width: 176rpx; min-height: 88rpx; margin: 0 0 0 var(--sp-sm); box-shadow: none; }
