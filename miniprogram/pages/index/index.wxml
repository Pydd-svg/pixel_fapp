<view class="page-index">
  <view wx:if="{{demoMode}}" class="idx-demo-bar">演示模式 · 数据为预置样例</view>

  <!-- 品牌行 -->
  <view class="idx-topbar" hover-class="is-pressed" hover-stay-time="80" bindtap="onLogoTap">
    <view class="idx-brand">
      <view class="idx-brand-mark">避</view>
      <view class="idx-brand-name">避坑导购</view>
    </view>
    <view class="idx-topbar-pill" bindlongpress="onVersionLongPress">BETA</view>
  </view>

  <!-- 日期与问候 -->
  <view class="idx-hello">
    <view class="idx-hello-date">{{todayLabel}}</view>
    <view class="idx-hello-title">{{greeting}}，今天想<text class="idx-hello-em">避开什么坑</text>？</view>
    <view class="idx-hello-sub">下单前 30 秒，先看红线，再下单</view>
  </view>

  <!-- 周历横排 -->
  <view class="idx-week">
    <view wx:for="{{weekDays}}" wx:key="date" class="idx-day {{item.isToday ? 'idx-day-on' : ''}}">
      <text class="idx-day-label">{{item.label}}</text>
      <text class="idx-day-num">{{item.date}}</text>
      <view wx:if="{{item.isToday}}" class="idx-day-dot"></view>
    </view>
  </view>

  <!-- 第 1 步 -->
  <view class="hm-step" hover-class="is-pressed" hover-stay-time="80" bindtap="goAsk">
    <view class="hm-step-main">
      <view class="hm-step-badge">第 1 步</view>
      <view class="hm-step-title">先问一句，再下单</view>
      <view class="hm-step-desc">说说想买的东西，30 秒出一张避坑卡</view>
    </view>
    <view class="hm-step-go">›</view>
  </view>

  <!-- 第 2 步 -->
  <view class="hm-step hm-step-2" hover-class="is-pressed" hover-stay-time="80" bindtap="goVerify">
    <view class="hm-step-main">
      <view class="hm-step-badge">第 2 步</view>
      <view class="hm-step-title">全网搜索评价</view>
      <view class="hm-step-desc">看看真实用户怎么说，再决定买不买</view>
    </view>
    <view class="hm-step-go">›</view>
  </view>

  <!-- 档案入口：与上面两张同款（深墨底 + 柠檬绿圆箭头），整卡可点 -->
  <view class="hm-step hm-step-3" hover-class="is-pressed" hover-stay-time="80" bindtap="goArchive">
    <view class="hm-step-main">
      <view class="hm-step-badge">我的档案</view>
      <view class="hm-step-title">
        <text class="idx-stat-num">{{archiveCount}}</text><text class="idx-stat-unit"> 张决策卡</text>
      </view>
      <view class="hm-step-desc">每次提问都会留下一张卡，随时回看</view>
    </view>
    <view class="hm-step-go">›</view>
  </view>

  <!-- 最近看过 -->
  <view wx:if="{{hasArchive}}" class="idx-list">
    <view class="idx-list-row idx-list-row-last" hover-class="is-pressed" hover-stay-time="80" bindtap="goArchive">
      <view class="idx-list-icon idx-list-icon-a">档</view>
      <view class="idx-list-body">
        <view class="idx-list-title">最近看过</view>
        <view class="idx-list-desc">回看之前生成的决策卡</view>
      </view>
      <view class="idx-list-arrow">›</view>
    </view>
  </view>

  <!-- 底部双入口 -->
  <view class="idx-dock">
    <view class="idx-dock-item" hover-class="is-pressed" hover-stay-time="80" bindtap="goAsk">
      <view class="idx-dock-icon">问</view>
      <text class="idx-dock-text">问一句</text>
    </view>
    <view class="idx-dock-item" hover-class="is-pressed" hover-stay-time="80" bindtap="goArchive">
      <view class="idx-dock-icon idx-dock-icon-b">档</view>
      <text class="idx-dock-text">我的档案</text>
    </view>
  </view>
</view>
