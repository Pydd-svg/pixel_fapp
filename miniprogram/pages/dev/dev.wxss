/* 自检页样式 —— 只求可读，不做视觉 */
.dev { padding: 24rpx; }
.dev__block { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.dev__label { display: block; font-size: 22rpx; color: #9CA3AF; margin-top: 12rpx; }
.dev__value { display: block; font-size: 24rpx; color: #1F2937; word-break: break-all; }
.dev__row { display: flex; flex-wrap: wrap; margin-bottom: 8rpx; }
.dev__btn { padding: 16rpx 20rpx; margin: 0 12rpx 12rpx 0; background: #fff; border-radius: 12rpx; font-size: 24rpx; }
.dev__pre { display: block; background: #111827; color: #D1D5DB; font-size: 22rpx; padding: 16rpx; border-radius: 12rpx; white-space: pre-wrap; word-break: break-all; }
.dev__pre--out { margin-top: 8rpx; min-height: 200rpx; }
